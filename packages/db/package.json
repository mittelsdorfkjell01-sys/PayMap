{
  "name": "@paymap/db",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev --name init",
    "seed": "ts-node prisma/seed.ts",
    "seed:guides": "ts-node prisma/seed-sprint8-guides.ts",
    "seed:guides:rom": "ts-node --project tsconfig.json prisma/seed-sprint8-rom.ts",
    "seed:premium": "ts-node --project tsconfig.json prisma/seed-premium.ts",
    "seed:premium:lissabon": "ts-node --project tsconfig.json prisma/seed-sprint9-lissabon.ts",
    "seed:premium:madrid": "ts-node --project tsconfig.json prisma/seed-sprint9-madrid.ts",
    "seed:premium:amsterdam": "ts-node --project tsconfig.json prisma/seed-sprint9-amsterdam.ts",
    "seed:premium:wien": "ts-node --project tsconfig.json prisma/seed-sprint9-wien.ts",
    "seed:premium:dubai": "ts-node --project tsconfig.json prisma/seed-sprint9-dubai.ts",
    "seed:premium:porto": "ts-node --project tsconfig.json prisma/seed-sprint9-porto.ts",
    "seed:col:porto": "ts-node --project tsconfig.json prisma/seed-col-porto.ts",
    "seed:col:berlin": "ts-node --project tsconfig.json prisma/seed-col-berlin.ts",
    "seed:taxdata": "ts-node --project tsconfig.json prisma/seed-taxdata.ts",
    "seed:inflation:forecast": "ts-node --project tsconfig.json prisma/seed-inflation-forecast.ts",
    "seed:premium:barcelona": "ts-node --project tsconfig.json prisma/seed-sprint9-barcelona.ts",
    "seed:premium:rom-premium": "ts-node --project tsconfig.json prisma/seed-sprint9-rom-premium.ts",
    "seed:premium:paris": "ts-node --project tsconfig.json prisma/seed-sprint9-paris.ts",
    "seed:all": "npm run seed && npm run seed:guides && npm run seed:premium",
    "studio": "prisma studio",
    "import:scores": "ts-node scripts/import-scores.ts",
    "import:derived": "ts-node scripts/import-derived-scores.ts"
  },
  "dependencies": {
    "@paymap/tax-engine": "*",
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3"
  },
  "exports": {
    "./tax-data": "./prisma/tax-data.ts",
    "./col-categories": "./prisma/col-categories.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
