{
  "name": "@paymap/db",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev --name init",
    "seed": "ts-node prisma/seed.ts",
    "seed:guides": "ts-node prisma/seed-sprint8-guides.ts",
    "seed:guides:rom": "ts-node --project tsconfig.json prisma/seed-sprint8-rom.ts",
    "seed:premium": "ts-node --project tsconfig.json prisma/seed-premium.ts",
    "seed:premium:lissabon": "ts-node --project tsconfig.json prisma/seed-sprint9-lissabon.ts",
    "seed:premium:madrid": "ts-node --project tsconfig.json prisma/seed-sprint9-madrid.ts",
    "seed:premium:amsterdam": "ts-node --project tsconfig.json prisma/seed-sprint9-amsterdam.ts",
    "seed:premium:wien": "ts-node --project tsconfig.json prisma/seed-sprint9-wien.ts",
    "seed:premium:dubai": "ts-node --project tsconfig.json prisma/seed-sprint9-dubai.ts",
    "seed:all": "npm run seed && npm run seed:guides && npm run seed:premium",
    "studio": "prisma studio",
    "import:scores": "ts-node scripts/import-scores.ts",
    "import:derived": "ts-node scripts/import-derived-scores.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
