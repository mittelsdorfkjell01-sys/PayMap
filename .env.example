# ── Database ──────────────────────────────────────────────────────────────────
# Neon / Supabase / any PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/paymap

# ── Auth (Supabase) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin ─────────────────────────────────────────────────────────────────────
# Password for the /admin section — must be set, no default in production
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cron jobs (Vercel Cron) ───────────────────────────────────────────────────
# Random secret used to authenticate cron requests — must be set for cron to run
CRON_SECRET=change-me-to-a-random-string

# ── Exchange rates ────────────────────────────────────────────────────────────
# No API key needed — uses Frankfurter (api.frankfurter.dev), data from ECB.
# Cron runs daily at 02:00 UTC via Vercel Cron (see apps/nextjs/vercel.json).

# ── File uploads (Vercel Blob) ────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# ── Seed ─────────────────────────────────────────────────────────────────────
# Password for the seeded admin@paymap.io account — change before seeding production
SEED_ADMIN_PASSWORD=change-me-before-seeding-production

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Disabled by default until privacy policy and cookie banner are live (DSGVO).
# Set to "true" in production only after legal review.
ENABLE_SEARCH_TRACKING=false
ENABLE_ANONYMOUS_CALC_SAVE=false
