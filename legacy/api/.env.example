# legacy/api (Express, @paymap/api) — copy to .env and fill in real values.

# Postgres connection (Neon). Use the STAGING branch URL for local/staging work,
# the prod branch only for prod. Read by the Prisma client in src/lib/prisma.ts.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require

# Secret for signing/verifying admin JWTs. Any sufficiently long random string.
JWT_SECRET=change-me

# Allowed CORS origin for the web app. Dev default below matches Vite on :5173.
CORS_ORIGIN=http://localhost:5173

# Port the API listens on. The web dev proxy (vite.config.ts) targets :3001.
PORT=3001
