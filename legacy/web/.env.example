# legacy/web (Vite + React, @paymap/web) — copy to .env if you need to override.

# Base URL for API calls (src/api/client.ts). Leave EMPTY in dev: the Vite proxy
# in vite.config.ts forwards /api → http://localhost:3001. Set only when the API
# is hosted elsewhere (e.g. a deployed URL).
VITE_API_URL=
